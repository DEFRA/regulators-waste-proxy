{
  "TraceHeader": "x-cdp-request-id",
  "Health": {
    "All": {
      "ApiKey": "",
      "DownstreamTimeoutMilliseconds": 5000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "formatter": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
              }
            }
          ]
        }
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "RegulatorsWasteDashboard": {
        "ClusterId": "RegulatorsWasteDashboard",
        "Match": {
          "Path": "/{**catch-all}"
        },
        "Metadata": {
          "Shuttered": false
        },
        "Transforms": [
          {
            "X-Forwarded": "Set",
            "Prefix": "Off"
          }
        ]
      },
      "RegulatorsCertificatesOfCompliance": {
        "ClusterId": "RegulatorsCertificatesOfCompliance",
        "Match": {
          "Path": "/certificates-of-compliance/{**catch-all}"
        },
        "Metadata": {
          "Shuttered": false
        },
        "Transforms": [
          {
            "X-Forwarded": "Set",
            "Prefix": "Off"
          },
          {
            "PathRemovePrefix": "/certificates-of-compliance"
          },
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/certificates-of-compliance"
          }
        ]
      }
    },
    "Clusters": {
      "RegulatorsWasteDashboard": {
        "Destinations": {
          "Primary": {
            "Address": "https://unconfigured.invalid/"
          }
        }
      },
      "RegulatorsCertificatesOfCompliance": {
        "Destinations": {
          "Primary": {
            "Address": "https://unconfigured.invalid/"
          }
        }
      }
    }
  }
}
