{
  "ReverseProxy": {
    "Clusters": {
      "RegulatorsWasteDashboard": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "Primary": {
            "Address": "https://localhost:7154/"
          }
        }
      },
      "RegulatorsCertificatesOfCompliance": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "Primary": {
            "Address": "https://localhost:3000/"
          }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u4}] {Message} {Properties}{NewLine}{Exception}"
        }
      }
    ]
  }
}
